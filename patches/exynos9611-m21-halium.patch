--- a/arch/arm64/configs/exynos9611-m21_defconfig
+++ b/arch/arm64/configs/exynos9611-m21_defconfig
@@ -1,3 +1,50 @@
+# -----------------------------------------------------------------------------
+# Mobile Linux & Halium Hardware-Enablement Configuration
+# Target: Samsung Galaxy M21 (SM-M215F / Exynos 9611)
+# -----------------------------------------------------------------------------
+
+# Core Linux Namespaces & Containers (for LXC Android container & systemd)
+CONFIG_NAMESPACES=y
+CONFIG_UTS_NS=y
+CONFIG_IPC_NS=y
+CONFIG_USER_NS=y
+CONFIG_PID_NS=y
+CONFIG_NET_NS=y
+CONFIG_CGROUPS=y
+CONFIG_CGROUP_DEVICE=y
+CONFIG_CGROUP_CPUACCT=y
+CONFIG_CGROUP_FREEZER=y
+CONFIG_CGROUP_SCHED=y
+CONFIG_CPUSETS=y
+CONFIG_MEMCG=y
+CONFIG_MEMCG_SWAP=y
+CONFIG_DEVTMPFS=y
+CONFIG_DEVTMPFS_MOUNT=y
+CONFIG_SYSVIPC=y
+CONFIG_FHANDLE=y
+
+# Android Binder IPC & Ashmem (Required for libhybris, Mali GPU, RIL, & Audio HAL)
+CONFIG_ANDROID=y
+CONFIG_ANDROID_BINDER_IPC=y
+CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
+CONFIG_ASHMEM=y
+
+# Virtual Terminal & Framebuffer (for boot splash, tty, and Wayland compositor)
+CONFIG_VT=y
+CONFIG_VT_CONSOLE=y
+CONFIG_FB=y
+CONFIG_FRAMEBUFFER_CONSOLE=y
+CONFIG_LOGO=y
+
+# Disable Android Paranoid Networking (allows standard Linux userspace to create sockets)
+# CONFIG_ANDROID_PARANOID_NETWORK is not set
+
+# Live Rootfs & OverlayFS support
+CONFIG_OVERLAY_FS=y
+CONFIG_SQUASHFS=y
+CONFIG_SQUASHFS_XZ=y
+CONFIG_SQUASHFS_ZSTD=y
+
 # USB Gadget & Networking (for emergency SSH rescue shell at 172.16.42.1)
 CONFIG_USB_CONFIGFS=y
 CONFIG_USB_CONFIGFS_NCM=y
 CONFIG_USB_CONFIGFS_ECM=y
 CONFIG_USB_CONFIGFS_RNDIS=y
 CONFIG_USB_CONFIGFS_F_FS=y
